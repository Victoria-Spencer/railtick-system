<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.rail.ticketservice.mapper.StationMapper">

    <select id="pageQuery" resultType="org.rail.ticketservice.model.vo.StationPageQueryVO"
            parameterType="org.rail.ticketservice.model.dto.StationPageQueryDTO">
        SELECT name, code, spell
        FROM station
        <where>
            <if test="queryType != null">AND query_type = #{queryType}</if>
            <if test="keyword != null">AND (
                `name` LIKE CONCAT('%', #{keyword}, '%')
                OR spell LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </select>

    <select id="batchQueryByTrainId" resultType="org.rail.ticketservice.model.vo.TrainStopStationVO"
            parameterType="java.lang.Long">
        SELECT tss.sequence AS sequence,
               tss.arrival_time AS arrivalTime,
               tss.departure_time AS departure_time,
               s.name AS stationName
        FROM train_stop_station tss
                 INNER JOIN station s
                            ON tss.station_id = s.id
        WHERE
            tss.train_id = #{trainId}
    </select>





    <!--&lt;!&ndash; 定义TrainDetailVO的结果映射，包含嵌套的列车类型列表 &ndash;&gt;
    <resultMap id="TrainDetailVOResultMap" type="org.rail.ticketservice.model.vo.TrainDetailVO">
        &lt;!&ndash; 映射列车基本信息字段 &ndash;&gt;
        <id column="trainId" property="trainId"/>
        <result column="trainNumber" property="trainNumber"/>
