        <result column="arrival" property="arrival"/>
        <result column="departureCode" property="departureCode"/>
        <result column="arrivalCode" property="arrivalCode"/>
        <result column="daysArrived" property="daysArrived"/>
        <result column="saleTime" property="saleTime"/>
        <result column="saleStatus" property="saleStatus"/>
        <result column="departureStationId" property="departureStationId"/>
        <result column="arrivalStationId" property="arrivalStationId"/>
        <result column="startSequence" property="startSequence"/>
        <result column="endSequence" property="endSequence"/>

        &lt;!&ndash; 嵌套映射列车类型列表：通过子查询获取当前列车的所有类型 &ndash;&gt;
